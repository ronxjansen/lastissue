{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core IPC, events, clipboard, dialogs, deep links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "deep-link:default"
  ]
}
